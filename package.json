{
  "name": "@crimsonearth/javascript-visual-language",
  "version": "0.1.0",
  "description": "A typed visual language for JavaScript, TypeScript, architecture, and agent-system concepts.",
  "type": "module",
  "license": "MIT",
  "author": "Kevin Liwag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrimsonEarth/javascript-visual-language.git"
  },
  "homepage": "https://github.com/CrimsonEarth/javascript-visual-language#readme",
  "bugs": {
    "url": "https://github.com/CrimsonEarth/javascript-visual-language/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "PROVENANCE.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./svg/*": "./dist/svg/*.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "build:package": "tsc -p tsconfig.build.json && node scripts/export-svgs.mjs",
    "build:catalog": "vite build",
    "build": "npm run clean && npm run typecheck && npm run test && npm run build:package && npm run build:catalog",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run build && npm run check:dist"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "check-error": "^2.1.3",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.1",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "js-tokens": "^9.0.1",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.16",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.25",
    "rollup": "^4.62.4",
    "siginfo": "^2.0.0",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "strip-literal": "^3.1.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tinypool": "^1.1.1",
    "tinyrainbow": "^3.1.1",
    "tinyspy": "^4.0.4",
    "undici-types": "^7.18.2",
    "vite-node": "^3.2.4",
    "why-is-node-running": "^2.3.0"
  },
  "keywords": []
}
